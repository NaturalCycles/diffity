{
  "name": "@naturalcycles/diffity",
  "version": "0.10.0",
  "description": "Agent-agnostic, GitHub-style diff viewer and code review tool with a live agent loop",
  "type": "module",
  "bin": {
    "diffity": "./dist/index.js"
  },
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx build.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dayjs": "^1.11.20",
    "open": "^11.0.0",
    "picocolors": "^1.1.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "git",
    "diff",
    "viewer",
    "cli",
    "code-review",
    "github"
  ],
  "author": "Natural Cycles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaturalCycles/diffity.git"
  },
  "homepage": "https://github.com/NaturalCycles/diffity",
  "bugs": {
    "url": "https://github.com/NaturalCycles/diffity/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
